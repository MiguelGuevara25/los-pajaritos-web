---
import { Menu, X } from "@lucide/astro";
import { ui, defaultLang } from "../i18n/ui";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = ui[lang];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300 on-dark text-on-dark"
>
  <a
    href="#contenido"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:rounded-sm focus:bg-background focus:px-3 focus:py-2 focus:text-foreground"
  >
    {t.ui.skipToContent}
  </a>

  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:h-18 md:px-8">
    <a href="#inicio" class="font-display text-xl font-semibold tracking-tight md:text-2xl">
      {t.brand.name}
    </a>

    <!-- Navegación desktop -->
    <nav aria-label={t.ui.mainNavLabel} class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm font-medium">
        {t.nav.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="relative py-2 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-terracotta after:transition-transform after:duration-300 hover:after:scale-x-100"
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <LanguageSwitcher />
        </li>
      </ul>
    </nav>

    <!-- Barra móvil -->
    <div class="flex items-center gap-2 md:hidden">
      <LanguageSwitcher />
      <button
        id="menu-toggle"
        type="button"
        class="-mr-2 inline-flex h-11 w-11 items-center justify-center cursor-pointer"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label={t.ui.menuOpen}
      >
        <span id="icon-menu" class="block"><Menu class="size-6" /></span>
        <span id="icon-close" class="hidden"><X class="size-6" /></span>
      </button>
    </div>
  </div>

  <!-- Desplegable móvil -->
  <nav
    id="menu-movil"
    aria-label={t.ui.mainNavLabel}
    class="hidden border-t border-border bg-background text-foreground md:hidden"
  >
    <ul class="mx-auto max-w-6xl px-5 py-3">
      {t.nav.map((item) => (
        <li>
          <a
            href={`#${item.id}`}
            class="mobile-link flex items-center justify-between border-b border-border py-4 font-display text-2xl last:border-0"
          >
            {item.label}
            <span aria-hidden class="text-base text-terracotta">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("menu-movil");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  let isOpen = false;

  const solidClasses = ["border-b", "border-border", "bg-background/95", "text-foreground", "backdrop-blur"];
  const transparentClasses = ["on-dark", "text-on-dark"];

  function updateHeader() {
    const isScrolled = window.scrollY > 48;
    const isSolid = isScrolled || isOpen;

    if (isSolid) {
      header?.classList.add(...solidClasses);
      header?.classList.remove(...transparentClasses);
    } else {
      header?.classList.remove(...solidClasses);
      header?.classList.add(...transparentClasses);
    }
  }

  function setMenuOpen(open: boolean) {
    isOpen = open;
    menuToggle?.setAttribute("aria-expanded", String(isOpen));
    if (isOpen) {
      mobileNav?.classList.remove("hidden");
      iconMenu?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    } else {
      mobileNav?.classList.add("hidden");
      iconMenu?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }
    updateHeader();
  }

  menuToggle?.addEventListener("click", () => setMenuOpen(!isOpen));

  window.addEventListener("scroll", updateHeader, { passive: true });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) setMenuOpen(false);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  updateHeader();
</script>
