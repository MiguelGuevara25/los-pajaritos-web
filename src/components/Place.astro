---
import { Check } from "@lucide/astro";
import Reveal from "./Reveal.astro";

import { ui, defaultLang } from "../i18n/ui";
import type { Amenity } from "../types/index.type";

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = ui[lang];

const { place } = t;

function confirmedAmenities(amenities: Amenity[]) {
  return amenities.filter((a) => a.confirmed);
}

const amenities = confirmedAmenities(place.amenities);
---

<section id="lugar" class="py-20 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <Reveal class="md:col-span-7">
        <p class="eyebrow">{place.eyebrow}</p>
        <h2 class="mt-4 text-4xl font-medium leading-tight md:text-6xl">
          {place.title}
        </h2>
      </Reveal>
      <Reveal delay={120} class="md:col-span-5">
        <p class="text-lg leading-relaxed text-muted-foreground">
          {place.intro}
        </p>
      </Reveal>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-12 md:gap-6">
      <Reveal as="figure" variant="image" class="md:col-span-8">
        <img
          src={place.main.src}
          alt={place.main.alt}
          width={place.main.width}
          height={place.main.height}
          loading="lazy"
          decoding="async"
          class="aspect-4/3 w-full rounded-sm object-cover"
        />
        <figcaption class="mt-3 text-sm text-muted-foreground">
          {place.main.caption}
        </figcaption>
      </Reveal>
      <div class="grid grid-cols-2 gap-4 md:col-span-4 md:grid-cols-1 md:gap-6">
        {place.secondary.map((img, i) => (
          <Reveal as="figure" variant="image" delay={120 + i * 120}>
            <img
              src={img.src}
              alt={img.alt}
              width={img.width}
              height={img.height}
              loading="lazy"
              decoding="async"
              class="aspect-4/3 w-full rounded-sm object-cover md:aspect-3/2"
            />
            <figcaption class="mt-3 text-sm text-muted-foreground">
              {img.caption}
            </figcaption>
          </Reveal>
        ))}
      </div>
    </div>

    {amenities.length > 0 && (
      <Reveal class="mt-14 border-t border-border pt-8">
        <h3 class="eyebrow">{place.amenitiesTitle}</h3>
        <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
          {amenities.map((a) => (
            <li class="flex items-center gap-2">
              <Check aria-hidden class="size-4 text-terracotta" />
              {a.label}
            </li>
          ))}
        </ul>
      </Reveal>
    )}
  </div>
</section>
